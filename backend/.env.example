# Copie para ".env" nesta mesma pasta (backend/). Requer os servicos do
# docker-compose.infra.yml (raiz do repo) rodando:
#   docker compose -f docker-compose.infra.yml up -d

PORT=3333

DATABASE_URL=postgres://chatrag:troque-esta-senha-postgres@localhost:5433/chatrag
REDIS_URL=redis://localhost:6379

# Chave usada para derivar a KEK local de desenvolvimento (envelope encryption,
# ver ADR-002). NUNCA reutilize este valor em homologacao/producao.
APP_MASTER_KEY=dev-only-change-me-32-bytes-minimum

SESSION_COOKIE_NAME=chatrag_session
SESSION_TTL_HOURS=12

# Origem do painel (dev server do Vite/TanStack Start na raiz do repo)
CORS_ORIGIN=http://localhost:8080

# Master so age com verificacao em duas etapas ativa. Ligue em producao.
# MASTER_2FA_REQUIRED=true

# Webhooks de saida: "true" libera http e rede interna. So teste/dev local.
# WEBHOOKS_ALLOW_PRIVATE_NETWORK=false

# Canais (docs/integrations/whatsapp.md): endereco publico da API para a URL de
# webhook. META_GRAPH_URL so muda em teste (API da Meta simulada).
# PUBLIC_API_URL=https://api.sua-empresa.com.br
# META_GRAPH_URL=https://graph.facebook.com/v21.0
# TELEGRAM_API_URL=https://api.telegram.org

# Storage S3 local (SeaweedFS, ver docker-compose.infra.yml na raiz)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=chatrag
S3_SECRET_ACCESS_KEY=troque-esta-senha-storage
S3_BUCKET=chatrag-sources
S3_FORCE_PATH_STYLE=true

# IA (ver .env.example na raiz e docs/decisions/ADR-005)
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=
