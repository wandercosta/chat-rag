# Copie para ".env" nesta mesma pasta (backend/). Requer os servicos do
# docker-compose.yml (raiz do repo) rodando: docker compose up -d

PORT=3333

DATABASE_URL=postgres://chatrag:chatrag@localhost:5433/chatrag
REDIS_URL=redis://localhost:6379

# Chave usada para derivar a KEK local de desenvolvimento (envelope encryption,
# ver ADR-002). NUNCA reutilize este valor em homologacao/producao.
APP_MASTER_KEY=dev-only-change-me-32-bytes-minimum

SESSION_COOKIE_NAME=chatrag_session
SESSION_TTL_HOURS=12

# MinIO local (ver docker-compose.yml na raiz)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=chatrag
S3_SECRET_ACCESS_KEY=chatrag123
S3_BUCKET=chatrag-sources
S3_FORCE_PATH_STYLE=true
