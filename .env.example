# Copie este arquivo para ".env" (mesma pasta) antes de rodar docker compose.
# ".env" nao deve ser commitado - ele fica de fora do git via .gitignore.
# Este mesmo arquivo tambem e lido pelo Vite (variaveis VITE_* ficam
# expostas ao codigo do painel; as demais so importam para o docker compose).

# Painel -> API (backend/, ver backend/README.md)
VITE_API_BASE_URL=http://localhost:3333

POSTGRES_USER=chatrag
POSTGRES_PASSWORD=chatrag
POSTGRES_DB=chatrag
POSTGRES_PORT=5433

REDIS_PORT=6379

MINIO_ROOT_USER=chatrag
MINIO_ROOT_PASSWORD=chatrag123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BACKEND_PORT=3333

# Chave mestre para criptografia — TROQUE EM PRODUCAO (min 32 chars)!
APP_MASTER_KEY=dev-master-key-32-chars-long-secret!

# ---------------------------------------------------------------------------
# Painel Web
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000

# CORS — origens que o backend aceita (use o mesmo valor de VITE_API_BASE_URL)
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Usuario Master (criado automaticamente na primeira execucao do container)
# ---------------------------------------------------------------------------
MASTER_EMAIL=admin@chatrag.local
MASTER_PASSWORD=Admin@2025!
