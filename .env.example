# Copie para ".env" antes do primeiro `docker compose up`:
#   cp .env.example .env
#
# Os valores abaixo sao ficticios e servem so para rodar localmente.
# ".env" fica fora do Git (.gitignore). Nunca commite chaves reais.

# ---------------------------------------------------------------------------
# IA — escolha o provedor do chat. Sem chave, use "local": o assistente
# responde com o trecho mais relevante do documento (sem LLM).
# ---------------------------------------------------------------------------
# Valores: local | openai | anthropic
AI_PROVIDER=local
# Necessario se AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Necessario se AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Embeddings: vazio = automatico (OpenAI quando AI_PROVIDER=openai com chave,
# senao o modelo multilingue local, que roda no container). Trocar depois de
# indexar exige reindexar as fontes.
# Valores: openai | local | hash
EMBEDDING_PROVIDER=

# ---------------------------------------------------------------------------
# Acessos de demonstracao (criados automaticamente)
# ---------------------------------------------------------------------------
MASTER_EMAIL=master@chatrag.local
MASTER_PASSWORD=troque-esta-senha-master
DEMO_ADMIN_EMAIL=admin@demo-consumidor.local
DEMO_ADMIN_PASSWORD=troque-esta-senha-demo
# Chave publica do widget usada por http://localhost:3333/demo (so vale em localhost)
DEMO_WIDGET_KEY=pk_test_demo_somente_localhost

# Canais (docs/integrations/whatsapp.md). Endereco publico da API (HTTPS), usado
# na URL de webhook que se cola na Meta. Sem ele, vale o Host da requisicao.
# PUBLIC_API_URL=https://api.sua-empresa.com.br

# ---------------------------------------------------------------------------
# Infraestrutura
# ---------------------------------------------------------------------------
POSTGRES_USER=chatrag
POSTGRES_PASSWORD=troque-esta-senha-postgres
POSTGRES_DB=chatrag
# Storage de arquivos (S3 compativel)
S3_ACCESS_KEY_ID=chatrag
S3_SECRET_ACCESS_KEY=troque-esta-senha-storage
# Chave mestre da criptografia das chaves BYOK (min. 32 caracteres)
APP_MASTER_KEY=troque-esta-chave-mestre-com-32-caracteres

BACKEND_PORT=3333
FRONTEND_PORT=3000
